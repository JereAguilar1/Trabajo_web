# Copiar a .env (make run-app lo hace solo). .env no se versiona.
POSTGRES_USER=app_user
# Vacío: al crear .env, `make run-app` genera una contraseña aleatoria.
# Si copiás este archivo a mano, completala.
POSTGRES_PASSWORD=
POSTGRES_DB=proyectos_db
# puerto del host mapeado al 5432 del contenedor
DB_HOST_PORT=5433
