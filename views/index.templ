package views

// IndexPage es la página principal del Sistema de Gestión de Proyectos:
// usa el Layout y compone, para cada entidad, su lista y su formulario plegable.
templ IndexPage(title string, data PageData) {
	@Layout(title) {
		<h1>{ title }</h1>
		if data.Error != "" {
			<article role="alert">{ data.Error }</article>
		}
		<article id="proyectos">
			<header><h2>Proyectos</h2></header>
			@ProyectoList(data.Proyectos)
			<details>
				<summary role="button">Nuevo proyecto</summary>
				@ProyectoForm(data.Clientes)
			</details>
		</article>
		<article id="clientes">
			<header><h2>Clientes</h2></header>
			@ClienteList(data.Clientes)
			<details>
				<summary role="button">Nuevo cliente</summary>
				@ClienteForm()
			</details>
		</article>
		<article id="desarrolladores">
			<header><h2>Desarrolladores</h2></header>
			@DesarrolladorList(data.Desarrolladores)
			<details>
				<summary role="button">Nuevo desarrollador</summary>
				@DesarrolladorForm()
			</details>
		</article>
	}
}
