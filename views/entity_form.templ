package views

import (
	"fmt"

	db "tp2/db/sqlc"
)

// ClienteForm: alta de cliente mediante HTMX (sin recarga de página).
templ ClienteForm() {
	<form
		hx-post="/clientes"
		hx-target="#clientes-list"
		hx-swap="outerHTML"
		hx-on::after-request="if(event.detail.successful) { this.reset(); this.closest('details').open = false }"
	>
		<label for="cliente-nombre">Nombre</label>
		<input type="text" id="cliente-nombre" name="nombre" required/>
		<button type="submit">Crear cliente</button>
		<small class="htmx-indicator">Guardando...</small>
	</form>
}

// DesarrolladorForm: alta de desarrollador mediante HTMX.
templ DesarrolladorForm() {
	<form
		hx-post="/desarrolladores"
		hx-target="#desarrolladores-list"
		hx-swap="outerHTML"
		hx-on::after-request="if(event.detail.successful) { this.reset(); this.closest('details').open = false }"
	>
		<div class="grid">
			<label>
				Nombre
				<input type="text" name="nombre" required/>
			</label>
			<label>
				Apellido
				<input type="text" name="apellido" required/>
			</label>
		</div>
		<button type="submit">Crear desarrollador</button>
		<small class="htmx-indicator">Guardando...</small>
	</form>
}

// ProyectoForm: alta de proyecto. Necesita los clientes para el <select>,
// porque todo proyecto pertenece a un cliente (clave foránea).
templ ProyectoForm(clientes []db.Cliente) {
	<div id="proyecto-form-container">
		@proyectoFormBody(clientes)
	</div>
}

// ProyectoFormOOB actualiza el formulario de proyectos fuera de banda (OOB)
// cuando cambia la lista de clientes.
templ ProyectoFormOOB(clientes []db.Cliente) {
	<div id="proyecto-form-container" hx-swap-oob="true">
		@proyectoFormBody(clientes)
	</div>
}

templ proyectoFormBody(clientes []db.Cliente) {
	if len(clientes) == 0 {
		<p>Para crear un proyecto primero tenés que crear un cliente.</p>
	} else {
		<form
			hx-post="/proyectos"
			hx-target="#proyectos-list"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) { this.reset(); this.closest('details').open = false }"
		>
			<div class="grid">
				<label>
					Nombre
					<input type="text" name="nombre" required/>
				</label>
				<label>
					Cliente
					<select name="id_cliente" required>
						for _, c := range clientes {
							<option value={ fmt.Sprint(c.IDCliente) }>{ c.Nombre }</option>
						}
					</select>
				</label>
				<label>
					Estado
					<select name="estado" required>
						for _, e := range Estados {
							<option value={ e.Valor }>{ e.Etiqueta }</option>
						}
					</select>
				</label>
			</div>
			<label>
				Descripción
				<input type="text" name="descripcion" required/>
			</label>
			<div class="grid">
				<label>
					Presupuesto
					<input type="number" name="presupuesto" min="0" step="0.01" value="0" required/>
				</label>
				<label>
					Gastos
					<input type="number" name="gastos" min="0" step="0.01" value="0" required/>
				</label>
				<label>
					Plazo de entrega
					<input type="date" name="tiempo_estimado" required/>
				</label>
			</div>
			<button type="submit">Crear proyecto</button>
			<small class="htmx-indicator">Guardando...</small>
		</form>
	}
}
